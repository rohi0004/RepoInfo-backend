APP_ENV=production
DEBUG=false
SECRET_KEY=REPLACE-WITH-STRONG-32-CHAR-SECRET
API_KEY_ENCRYPTION_SECRET=REPLACE-WITH-STRONG-32-CHAR-SECRET

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=repoinfo
POSTGRES_PASSWORD=REPLACE-ME
