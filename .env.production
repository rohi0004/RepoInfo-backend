# ============================================================================
# RepoInfo backend — PRODUCTION env (Railway)
# ----------------------------------------------------------------------------
# This file is a *template*. Do NOT commit real secrets to git.
# Copy each key into Railway → Service → Variables and fill the value.
#
# ⚠️  ROTATE LATER (these values were shared in chat):
#     - POSTGRES_PASSWORD (Neon)
#     - OPENAI_API_KEY
#     - OPENROUTER_API_KEY
#     - SECRET_KEY  (currently the dev fallback string — very unsafe)
#     - API_KEY_ENCRYPTION_SECRET (same)
# ============================================================================

# ---- App ----
APP_NAME=RepoInfo API
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

# ⚠️ Same as dev — regenerate with `openssl rand -hex 32` when you rotate.
SECRET_KEY=dev-secret-key-please-change-in-production-32chars
API_KEY_ENCRYPTION_SECRET=dev-encryption-key-please-change-32chars-min

# Public URLs — MUST be real domains, not localhost (email links, OAuth callbacks use these)
BACKEND_BASE_URL=https://repoinfo-backend-production.up.railway.app
FRONTEND_BASE_URL=https://repoinfo.in

ALLOWED_HOSTS=repoinfo-backend-production.up.railway.app,repoinfo.in
CORS_ORIGINS=https://repoinfo.in,https://www.repoinfo.in,http://localhost:5173,http://localhost:3000

# ---- Database (Neon Postgres) ----
POSTGRES_HOST=ep-soft-mud-axvinkiy-pooler.c-4.us-east-2.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=npg_UReNA8fJD7zX
POSTGRES_DB=neondb
POSTGRES_SSL_MODE=require
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ---- Redis (Upstash TLS) ----
# When REDIS_URL is set, it overrides REDIS_HOST/PORT/PASSWORD below and the
# code forces db=0 (Upstash free tier only exposes a single logical database).
REDIS_URL=rediss://default:ggAAAAAAAY50AAIgcDFhOTVhMTgwOWMyYTc0N2Y2OGZmMjMwMGYwYTc4MTM4OQ@alert-seahorse-102004.upstash.io:6379
# Legacy per-part fallback (unused while REDIS_URL is set):
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT / Auth ----
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_REMEMBER_ME_REFRESH_DAYS=90
JWT_ISSUER=repoinfo-api
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

# ---- OAuth (add these redirect URIs to Google/GitHub consoles) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://repoinfo-backend-production.up.railway.app/api/v1/auth/oauth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://repoinfo-backend-production.up.railway.app/api/v1/auth/oauth/github/callback

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_AI=30/minute

# ---- Object storage (Neon S3-compatible) ----
# File upload endpoints (repos/reports/exports/avatars/attachments) will fail
# until real S3 keys are set. App boots fine even with placeholders here
# because boto3 connects lazily.
AWS_ENDPOINT_URL_S3=https://br-restless-morning-axfjux78.storage.c-4.us-east-2.aws.neon.tech
AWS_ACCESS_KEY_ID=REPLACE_WITH_NEON_S3_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_NEON_S3_SECRET_KEY
AWS_REGION=us-east-2
STORAGE_BUCKET=repoinfo
STORAGE_PRESIGNED_URL_EXPIRE_SECONDS=3600

# ---- Elasticsearch ----
# Set to a valid dummy URL so the ES client constructor doesn't crash at
# startup. Real search endpoints fail with a graceful empty-result until you
# point this at Bonsai/Elastic Cloud.
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ---- Milvus ----
# Same idea — Milvus client is lazy so a valid hostname keeps startup clean.
# Replace with Zilliz Cloud host when you enable RAG / semantic search.
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
EMBEDDING_DIMENSION=1536

# ---- AI providers ----
DEFAULT_AI_PROVIDER=openrouter
GEMINI_API_KEY=
OPENAI_API_KEY=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
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=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
OLLAMA_BASE_URL=
AI_PROVIDER_FALLBACK_ORDER=openrouter,openai

# ---- Email (SMTP — required for verify / reset / OTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM_ADDRESS=noreply@repoinfo.in
EMAIL_FROM_NAME=RepoInfo

# ---- Billing (Stripe) — leave empty until you go live ----
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_TEAM=

# ---- Observability ----
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
LOG_LEVEL=INFO
LOG_JSON=true
PROMETHEUS_ENABLED=true

# ---- Repository analysis ----
REPO_CLONE_MAX_SIZE_MB=500
REPO_CLONE_TIMEOUT_SECONDS=300
REPO_CLONE_WORKDIR=/tmp/repoinfo/clones
REPO_MAX_FILE_SIZE_BYTES=2000000
