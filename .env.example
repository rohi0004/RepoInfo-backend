# ============================================================================
# RepoInfo backend .env — copy to .env and fill in the blanks.
# Every setting has a working default suitable for local docker-compose usage;
# only the secret values must be replaced for production.
# ============================================================================

# ---- App ----
APP_NAME=RepoInfo API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-32-characters-min-please-change
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=repoinfo
POSTGRES_PASSWORD=repoinfo
POSTGRES_DB=repoinfo
# disable for local docker-compose postgres; require for managed providers (e.g. Neon)
POSTGRES_SSL_MODE=disable
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT / Auth ----
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_REMEMBER_ME_REFRESH_DAYS=90
JWT_ISSUER=repoinfo-api
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

# ---- OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/github/callback

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_AI=30/minute

# ---- Object storage (S3-compatible, e.g. Neon S3 storage) ----
AWS_ENDPOINT_URL_S3=https://your-branch.storage.region.aws.neon.tech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
STORAGE_BUCKET=repoinfo

# ---- Elasticsearch ----
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ---- Milvus ----
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
EMBEDDING_DIMENSION=1536

# ---- AI providers ----
DEFAULT_AI_PROVIDER=claude
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
# Comma-separated. Tried in order when the active provider's request fails on a quota/credit error.
AI_PROVIDER_FALLBACK_ORDER=openai,openrouter

# ---- Email (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM_ADDRESS=noreply@repoinfo.dev
EMAIL_FROM_NAME=RepoInfo

# ---- Billing (Stripe) ----
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_TEAM=

# ---- Observability ----
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=INFO
LOG_JSON=false
PROMETHEUS_ENABLED=true

# ---- Repository analysis ----
REPO_CLONE_MAX_SIZE_MB=500
REPO_CLONE_TIMEOUT_SECONDS=300
REPO_CLONE_WORKDIR=/tmp/repoinfo/clones
REPO_MAX_FILE_SIZE_BYTES=2000000

# ---- API-key encryption ----
API_KEY_ENCRYPTION_SECRET=change-me-32-characters-min-please-change
